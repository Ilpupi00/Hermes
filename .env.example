# Copiare questo file in .env e sostituire tutti i valori change-me.
# Non committare mai il file .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hermes
DB_USER=hermes
DB_PASSWORD=change-me-with-a-strong-database-password

# Autenticazione Control Room
# Generare una chiave, per esempio, con:
# openssl rand -hex 32
SECRET_KEY=change-me-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Hugging Face
# Lasciare vuoto se si usano soltanto modelli locali.
# Il token deve avere il permesso "Inference Providers".
HF_TOKEN=
# Provider remoto usato dai modelli hf_api della configurazione iniziale.
# Per Qwen2.5-0.5B-Instruct usare Featherless AI; "auto" resta supportato.
HF_INFERENCE_PROVIDER=featherless-ai

# Directory di scambio CSV
HERMES_INBOX=./uploads_web
HERMES_ARCHIVE=./processed
HERMES_FAILED=./failed
HERMES_INTERRUPTED=./interrupted

# Scheduler e worker
HERMES_POLL_INTERVAL=60
HERMES_CHUNK_SIZE=1000
HERMES_MAX_WORKERS=4
HERMES_MAX_RETRIES=3
HERMES_WORKER_CLASS=src.workers.hybrid_worker.HybridWorker

# Endpoint OpenAI-compatible locale (Ollama, llama.cpp o vLLM).
# Nel container Docker, localhost indica il container stesso: adeguare l'host
# quando il server LLM gira sul Mac o in un altro container.
HERMES_AI_BASE_URL=http://localhost:8000/v1
